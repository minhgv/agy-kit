{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StageResult",
  "type": "object",
  "properties": {
    "stage": { "type": "string" },
    "status": { "type": "string", "enum": ["passed", "failed", "cancelled", "timed_out", "blocked"] },
    "exit_code": { "type": "integer" }
  },
  "required": ["stage", "status", "exit_code"]
}
