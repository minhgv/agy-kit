#!/usr/bin/env bash
# Git Hooks for agy-kit — Deterministic Rule Enforcement
#
# Installation: cp .githooks/* .git/hooks/ && chmod +x .git/hooks/*
# Or: git config core.hooksPath .githooks
#
# pre-commit: gitleaks + conventional commit format check
set -euo pipefail

# 0. Run Autonomous Single-Pass Linter Fixer
python3 bin/fix_linter.py || {
    echo "⚠️ Warning: fix_linter encountered issues."
}

# 1. Gitleaks secret scan on staged files
if command -v gitleaks &>/dev/null; then
    gitleaks protect --staged --verbose --redact || {
        echo "❌ Gitleaks detected secrets in staged files. Commit blocked."
        exit 1
    }
fi

# 2. Lint staged files (if linter available)
if [ -f ".pre-commit-config.yaml" ] && command -v pre-commit &>/dev/null; then
    pre-commit run --files $(git diff --cached --name-only) || {
        echo "❌ Pre-commit checks failed. Fix issues and re-stage."
        exit 1
    }
fi

# 3. Run Unit Tests locally before allowing commit
python3 tests/unit/test_control_plane.py && python3 tests/unit/test_destructive_harness.py || {
    echo "❌ Unit tests failed. Fix failing tests before committing."
    exit 1
}

# 4. Audit Template Synchronization Drift
python3 bin/sync_templates.py --check || {
    echo "❌ Template drift detected. Run 'make sync-templates' before committing."
    exit 1
}

# 5. Run Python AST Syntax check on workspace
python3 -c "import glob, py_compile; [py_compile.compile(f, doraise=True) for f in glob.glob('src/agy_kit/**/*.py', recursive=True) + glob.glob('tests/**/*.py', recursive=True)]" || {
    echo "❌ Python syntax check failed."
    exit 1
}

echo "✅ Pre-commit checks passed."
